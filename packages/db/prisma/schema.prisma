generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELED
}

enum DispatchStatus {
  UNASSIGNED
  ASSIGNED
  PICKED_UP
  DROPPED_OFF
}

enum OfferStatus {
  OFFERED
  ACCEPTED
  EXPIRED
  REJECTED
}

enum CommunityVisibility {
  PUBLIC
  PRIVATE
}

enum CommunityRole {
  OWNER
  ADMIN
  MEMBER
}

enum BulkOrderStatus {
  OPEN
  LOCKED
  PLACED
  DELIVERED
  CANCELLED
}

model Restaurant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String   @default("")
  phone     String   @default("")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems  MenuItem[]
  orders     Order[]
  bulkOrders BulkOrder[]
}

model MenuItem {
  id           String   @id @default(cuid())
  restaurantId String
  name         String
  description  String   @default("")
  priceCents   Int
  imageUrl     String?
  category     String   @default("General")
  isAvailable  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id])
  orderItems OrderItem[]

  @@index([restaurantId])
}

model Order {
  id              String      @id @default(cuid())
  restaurantId    String
  status          OrderStatus @default(PENDING)
  customerName    String
  customerPhone   String
  deliveryAddress String
  subtotalCents   Int
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  restaurant Restaurant          @relation(fields: [restaurantId], references: [id])
  items      OrderItem[]
  dispatch   DispatchAssignment?
  offers     DispatchOffer[]

  @@index([restaurantId])
  @@index([status])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  menuItemId     String
  name           String
  unitPriceCents Int
  quantity       Int
  lineTotalCents Int

  order    Order    @relation(fields: [orderId], references: [id])
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
}

model Driver {
  id        String   @id @default(cuid())
  name      String
  phone     String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments DispatchAssignment[]
  offers      DispatchOffer[]
}

model DispatchAssignment {
  id        String         @id @default(cuid())
  orderId   String         @unique
  driverId  String
  status    DispatchStatus @default(UNASSIGNED)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  order  Order  @relation(fields: [orderId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@index([driverId])
  @@index([status])
}

model DispatchOffer {
  id        String      @id @default(cuid())
  orderId   String
  driverId  String
  status    OfferStatus @default(OFFERED)
  expiresAt DateTime
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  order  Order  @relation(fields: [orderId], references: [id])
  driver Driver @relation(fields: [driverId], references: [id])

  @@unique([orderId, driverId])
  @@index([orderId, status])
  @@index([driverId, status])
}

model Community {
  id              String              @id @default(cuid())
  name            String
  area            String
  description     String?
  visibility      CommunityVisibility @default(PUBLIC)
  createdByUserId String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  members    CommunityMember[]
  invites    CommunityInvite[]
  bulkOrders BulkOrder[]

  @@index([area])
  @@index([visibility, area])
  @@index([createdByUserId])
}

model CommunityMember {
  id          String        @id @default(cuid())
  communityId String
  userId      String
  role        CommunityRole @default(MEMBER)
  createdAt   DateTime      @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@index([communityId, role])
}

model CommunityInvite {
  id              String    @id @default(cuid())
  communityId     String
  code            String    @unique
  createdByUserId String
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  expiresAt       DateTime?

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@index([communityId, isActive])
}

model BulkOrder {
  id            String          @id @default(cuid())
  communityId   String
  restaurantId  String
  hostUserId    String
  title         String
  orderDeadline DateTime
  deliveryNotes String?
  status        BulkOrderStatus @default(OPEN)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  community    Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  restaurant   Restaurant             @relation(fields: [restaurantId], references: [id])
  participants BulkOrderParticipant[]

  @@index([communityId, status])
  @@index([restaurantId, status])
  @@index([hostUserId, status])
  @@index([orderDeadline])
}

model BulkOrderParticipant {
  id          String   @id @default(cuid())
  bulkOrderId String
  userId      String
  createdAt   DateTime @default(now())

  bulkOrder BulkOrder @relation(fields: [bulkOrderId], references: [id], onDelete: Cascade)

  @@unique([bulkOrderId, userId])
  @@index([userId])
}
